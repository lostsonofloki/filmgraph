# TMDB API Key
# Get your free API key at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Supabase (client + optional server-side cache helpers)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional for server-side cache writes in Vercel functions:
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# UPC cache freshness window in hours (default: 336 = 14 days)
UPC_CACHE_TTL_HOURS=336

# Supabase keep-alive (prevents Free plan auto-pausing after ~7 days of low activity)
# Server-side names used by scripts/supabase-keepalive.mjs; falls back to the VITE_ pair.
# SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Comma-separated override for the tables the ping reads, first readable one wins.
# SUPABASE_KEEPALIVE_TABLES=keepalive_heartbeat,upc_cache,profiles
# How many PostgREST reads each invocation performs (default 3, max 5).
# SUPABASE_KEEPALIVE_READS=3
# Required. Vercel Cron sends this as `Authorization: Bearer ...`. The route returns
# 503 and does not query Postgres until this is set in the Vercel project. Use the
# same value as the GitHub Actions secret CRON_SECRET if that backup job should run.
# CRON_SECRET=your_random_cron_secret_here

# Gemini API Key (Phase 5: AI Integration)
# Get your free API key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Phase 6.15: High-Speed AI Ensemble)
# Get your free API key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here
# Optional: pin a single Groq model instead of the built-in candidate list.
# Groq retires models regularly, so the app walks a candidate list and skips any that
# return model_not_found. Check https://console.groq.com/docs/deprecations before pinning.
# VITE_GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter API Key (Emergency Fallback)
# Get your key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# NYT Top Stories API Key (Editorial Enrichment)
# Get your key at: https://developer.nytimes.com/
VITE_NYT_API_KEY=your_nyt_api_key_here

# Fanart.tv API Key (Visual Enrichment)
# Get your key at: https://fanart.tv/get-an-api-key/
VITE_FANART_API_KEY=your_fanart_api_key_here

# Trakt OAuth App Credentials (Tracking Sync)
# Create app at: https://trakt.tv/oauth/applications
# Only the client id belongs here: Vite inlines every VITE_ variable into the browser bundle, so a
# client secret defined this way would be published. An OAuth code exchange has to run server-side
# and read an unprefixed TRAKT_CLIENT_SECRET instead.
VITE_TRAKT_CLIENT_ID=your_trakt_client_id_here

# OMDb API Key (Rotten Tomatoes badge on the movie page, server-side only, no VITE_ prefix)
# Get your free key at: https://www.omdbapi.com/apikey.aspx
# The browser calls /api/omdb-lookup, which reads this. `vite dev` does not serve that function,
# so the RT score is simply omitted locally; use `vercel dev` to exercise it.
OMDB_API_KEY=your_omdb_api_key_here

# Resend Bug Report Notifications (Server-side only, no VITE_ prefix)
# Get your key at: https://resend.com/api-keys
# Add these in Vercel Project Settings -> Environment Variables
RESEND_API_KEY=your_resend_api_key_here
BUG_REPORT_FROM_EMAIL=alerts@filmgraph.app
BUG_REPORT_ADMIN_EMAIL=your_admin_inbox@example.com

# Optional API Enrichment Feature Flags
# Set to true to enable each enrichment family.
VITE_FEATURE_EDITORIAL_ENRICHMENT=false
VITE_FEATURE_VISUAL_ENRICHMENT=false
VITE_FEATURE_TRAKT_ENRICHMENT=false

# Playwright Test Credentials
# Used by every authenticated spec in tests/ and by scripts/actor-badge-check.cjs.
# The same two names are exported by .github/workflows/playwright.yml from repository secrets.
TEST_USER_EMAIL=your_email@example.com
TEST_USER_PASSWORD=your_password

# Target for Playwright runs; defaults to https://filmgraph.app when unset.
# PLAYWRIGHT_BASE_URL=http://localhost:5173
